---
/**
 * Behandelingen — het ontwerp "Editorial Frames" (TASK-7.3).
 *
 * Referentie: design_handoff_nailsbyvera/Behandelingen.dc.html, met links de
 * desktoprender op 1280px en rechts de mobiele op 390px.
 *
 * Dit is de pagina waar bezoekers — en generatieve systemen — het antwoord
 * halen op "wat houdt het in, hoe lang duurt het, wat kost het" (PRD §8.4). De
 * behandelingen komen daarom uit de content collection `treatments` en niet uit
 * de opmaak; duur en prijs staan als platte tekst in de HTML.
 *
 * Onderaan staat de FAQ-accordeon (TASK-10) — dezelfde gedachte, in de vorm die
 * een generatief systeem het makkelijkst overneemt.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookingButton from '../components/BookingButton.astro';
import Card from '../components/Card.astro';
import Chip from '../components/Chip.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Header from '../components/Header.astro';
import Photo from '../components/Photo.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import Sparkle from '../components/Sparkle.astro';
import StatBlock from '../components/StatBlock.astro';
import StickyBookingBar from '../components/StickyBookingBar.astro';
import { photos } from '../data/images';

const treatments = (await getCollection('treatments')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Sorteren en filteren zit in FaqAccordion zelf, zodat de zichtbare lijst en de
// FAQPage-markup uit precies dezelfde reeks komen.
const faq = await getCollection('faq');

// De drie statkaarten onder de behandelblokken. De middelste staat in het
// ontwerp op blush-200 met een rose rand — dat is `tone="arch"`.
const stats = [
  {
    value: '4 weken',
    text: 'Zo lang kan je van een versteviging genieten.',
    tone: 'surface' as const,
  },
  {
    value: '7 dagen',
    text: '100% nagelgarantie in de eerste week.',
    tone: 'arch' as const,
  },
  {
    value: 'Advies',
    text: 'Kun je niet kiezen? Geen zorgen, ik denk graag met je mee.',
    tone: 'surface' as const,
  },
];
---

<Base
  title="Behandelingen"
  description="Nagelversteviging met Biab, gel of acrylgel, gellak en nail art in Hengelo (OV). Per behandeling zie je wat het inhoudt, hoe lang het duurt en wat het kost."
  header="none"
>
  {/* ---------- Hero ----------
      Full-bleed zoals de home, en anders dan Over mij: daar staat een portret
      dat op een breed scherm tot een strook wordt uitgesneden, hier een
      nagelfoto die elke verhouding aankan (les uit TASK-7.2). */}
  <section class="bg-soft p-3 lg:p-4">
    <div class="relative h-[400px] overflow-hidden rounded-card lg:h-[460px] lg:rounded-frame">
      <Photo
        photo={photos.nudeKortGlans}
        priority
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
      {/* Verloop uit het ontwerp; ink-900 op drie alfawaarden. */}
      <div
        class="absolute inset-0 bg-linear-to-b from-ink-900/[0.34] via-ink-900/[0.1] to-ink-900/60 via-45%"
        aria-hidden="true"
      >
      </div>
      {/* Twee extra scrims, niet in het ontwerp — dezelfde correctie als op Over
          mij. Deze foto is linksonder licht (een hand op een lichte ondergrond),
          precies waar het tekstblok staat. Met alleen het verloop hierboven
          haalde de gouden eyebrow van 12px het niet, en de h1 bleef op 1,2:1
          steken. In het prototype staat op die plek een grijze placeholder, dus
          daar kon dit niet opvallen. Gemeten op de gerenderde pagina, per glyph
          tegen de foto eronder — desktop: eyebrow 5,0 · h1 4,8 · intro 7,3;
          mobiel: 7,2 · 4,8 · 7,5. Zonder deze twee scrims bleef de h1 op 1,2:1
          steken. De onderste scrim is op mobiel zwaarder, omdat de foto daar
          anders wordt bijgesneden en het lichte deel juist achter de tekst valt. */}
      <div
        class="absolute inset-0 bg-linear-to-t from-ink-900/70 to-transparent lg:from-ink-900/45 lg:to-70%"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-ink-900/45 to-transparent to-60%"
        aria-hidden="true"
      >
      </div>

      <Header floating />

      <div class="absolute inset-x-[18px] bottom-5 max-w-[760px] lg:inset-x-10 lg:bottom-9">
        <Eyebrow onDark class="mb-[10px] lg:mb-[14px]">Behandelingen</Eyebrow>
        <h1 class="text-d38 text-white lg:text-d62">
          Geef jouw nagels een nieuwe look!
        </h1>
        <p
          class="mt-[10px] text-b15 text-white/85 lg:mt-[14px] lg:max-w-[560px] lg:text-b17"
        >
          Jouw nagels spreken als jouw persoonlijke visitekaartje. Geef jouw
          zelfvertrouwen een boost met die prachtige nagels!
        </p>
      </div>
    </div>
  </section>

  <div
    class="mx-auto flex max-w-site flex-col gap-3 px-gutter-m pt-3 pb-3 lg:gap-5 lg:px-gutter lg:pt-11 lg:pb-10"
  >
    {/* ---------- Introkaart ---------- */}
    <section>
      <Card flush class="p-[22px] lg:px-8 lg:py-7">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
          <h2 class="text-d24 lg:text-d28">
            Drie behandelingen, eindeloos veel varianten
          </h2>
          <ul class="flex list-none flex-wrap gap-2">
            {treatments.map((treatment) => <li><Chip>{treatment.data.label}</Chip></li>)}
          </ul>
        </div>
      </Card>
    </section>

    {/* ---------- De drie behandelblokken ----------
        Om en om gespiegeld op desktop: tekst-foto, foto-tekst, tekst-foto. Op
        mobiel staat de foto altijd boven de kaart, precies zoals de mobiele
        render — vandaar de foto eerst in de DOM en `lg:order-last` op de
        oneven blokken. */}
    {
      treatments.map((treatment, index) => {
        const { eyebrow, title, intro, bullets, duration, price, photo } = treatment.data;
        const photoRight = index % 2 === 0;

        return (
          <section
            class:list={[
              'grid items-stretch gap-3 lg:gap-4',
              photoRight
                ? 'lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]'
                : 'lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]',
            ]}
          >
            <PhotoFrame
              photo={photos[photo]}
              radius="frame"
              sizes="(min-width: 1024px) 560px, 100vw"
              class:list={[
                'max-lg:rounded-card-m min-h-[280px] lg:min-h-[460px]',
                photoRight && 'lg:order-last',
              ]}
            />

            <Card flush class="flex items-center p-[22px] lg:p-10">
              <div class="flex flex-col gap-3 lg:gap-4">
                <Eyebrow>{eyebrow}</Eyebrow>
                <h2 class="text-d28 lg:text-d40">{title}</h2>
                <p class="text-b15 text-copy lg:text-b16">{intro}</p>

                <ul class="flex list-none flex-col gap-2 lg:gap-2.5">
                  {bullets.map((bullet) => (
                    <li class="flex items-start gap-3 text-b14 text-ink-700 lg:text-b15">
                      <Sparkle size={12} class="mt-[6px] shrink-0" />
                      {bullet}
                    </li>
                  ))}
                </ul>

                {/* Duur en prijs als platte tekst — niet in een afbeelding en
                    niet achter JavaScript (PRD §8.4). Het ontwerp toont ze op
                    deze pagina niet; ze staan hier omdat dit de pagina is waar
                    bezoekers en AI-antwoorden ze zoeken. Vorm gelijk aan de
                    voetregel van ServiceCard: hairline erboven, feit ernaast. */}
                <dl class="flex flex-wrap gap-x-10 gap-y-3 border-t border-hair pt-3 lg:pt-4">
                  <div class="flex flex-col gap-1">
                    <dt class="text-b13 text-copy">Duur</dt>
                    <dd class="font-display text-d20 text-heading">{duration}</dd>
                  </div>
                  <div class="flex flex-col gap-1">
                    <dt class="text-b13 text-copy">Prijs</dt>
                    <dd class="font-display text-d20 text-heading">{price}</dd>
                  </div>
                </dl>

                <div class="pt-1">
                  <BookingButton label="Boek nu" block class="lg:w-auto" />
                </div>
              </div>
            </Card>
          </section>
        );
      })
    }

    {/* ---------- Statkaarten ----------
        Het ontwerp geeft deze sectie geen kop; zonder h2 zou hier een blok
        zonder titel staan. Zelfde oplossing als bij de stappenband op de home
        en het fotoraster op Over mij. */}
    <section class="lg:pt-1">
      <h2 class="sr-only">Goed om te weten</h2>
      <div class="grid gap-3 lg:grid-cols-3 lg:gap-4">
        {
          stats.map((stat) => (
            <Card tone={stat.tone}>
              <StatBlock value={stat.value} size="d38">
                {stat.text}
              </StatBlock>
            </Card>
          ))
        }
      </div>
    </section>

    {/* ---------- FAQ ----------
        Niet in het handoff-ontwerp; toegevoegd omdat het AI-kanaal aantoonbaar
        werkt (PRD §5.9, §8.4). Staat onderaan en niet hoger op de pagina: wie
        hier komt wil eerst weten wát de behandelingen zijn, en pas daarna hoe
        het praktisch zit. Geen menu-item en geen eigen URL — de vraag ontstaat
        op deze pagina. */}
    <FaqAccordion
      entries={faq}
      intro="De vragen die me het vaakst gesteld worden, met het antwoord erbij — zodat je weet waar je aan toe bent voordat je een afspraak maakt."
      class="lg:pt-3"
    />

    {/* ---------- CTA ---------- */}
    <CtaBand
      eyebrow="Plan jouw naildate"
      title={'"Step into luxury, walk out with style"'}
      text="Geniet van de mooiste nagels en laat ze schitteren!"
      label="Plan jouw afspraak!"
    />
  </div>

  <StickyBookingBar />
</Base>
