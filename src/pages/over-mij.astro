---
/**
 * Over mij — het ontwerp "Editorial Frames" (TASK-7.2).
 *
 * Referentie: design_handoff_nailsbyvera/Over mij.dc.html. Net als bij de home
 * toont dat bestand twee renders naast elkaar: links desktop op 1280px, rechts
 * mobiel op 390px. Twee breakpoints van dezelfde pagina.
 *
 * Dat bestand is één keer vervangen door een herziene versie van de ontwerper.
 * Alleen de hero veranderde daarin — zie de opmerking bij de hero hieronder.
 *
 * Deze pagina vervangt `/over-de-salon/` van de oude site. Dat is de enige URL
 * die verandert; de redirect wordt apart ingericht (PRD §7).
 *
 * Alle copy is letterlijk overgenomen uit de desktoprender en mag niet
 * herschreven worden (PRD §5.5). De teksten staan hier nog als constanten; ze
 * verhuizen naar content collections in TASK-8.
 */
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Chip from '../components/Chip.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Photo from '../components/Photo.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import StickyBookingBar from '../components/StickyBookingBar.astro';
import { photos } from '../data/images';

/** De opleidingen uit het verhaal, ook los zichtbaar als chips. */
const opleidingen = ['Magnetic Nail Design', 'Julia Visser', 'Tanya Savchenko'];

// Het fotoraster onderaan: vier tegels, in de volgorde van het ontwerp.
const salonfotos = [
  photos.blauweBloemetjes,
  photos.rozeOmbreSalon,
  photos.dieproodAmandel,
  photos.frenchGeleBloemetjes,
];
---

<Base
  title="Over mij"
  description="Hoe Nails by Vera ontstond: van nagels stylen bij mijn tante tot een eigen privésalon in Hengelo. Opgeleid bij Magnetic Nail Design, Julia Visser en Tanya Savchenko."
>
  {/* ---------- Hero ----------
      Als enige van de zes contentpagina's geen fotohero met een zwevende
      navigatie eroverheen, maar een lichte kaart met de tekst links en het
      portret rechts in een cirkel — en dus de gewone, solide header erboven.

      Dat is een herziening van het oorspronkelijke ontwerp. Daar stond hier
      dezelfde full-bleed fotohero als op de home, maar het enige portret dat er
      is (`vera-portret.jpeg`, 1080 × 1080) is een uitsnede op een lichte
      achtergrond: op een breed scherm bleef daar een strook van 4:1 van over
      waar alleen een mond in paste, en de witte achtergrond maakte de tekst
      eroverheen onleesbaar. De cirkelvorm gebruikt precies wat het portret wél
      is: vierkant. Daarmee is er geen liggende hero-foto meer nodig.

      De cirkel zit 11% op de foto ingezoomd (`-inset-[11%]` op een kader van
      92%), zodat de roze cirkel uit het portret het kader vult en de witte
      hoeken erbuiten vallen. De blush-200 eronder vangt op wat er bij een
      andere foto zou doorschijnen. */}
  {/* Op mobiel geen padding onderaan: de sectie hieronder begint zelf met 12px,
      en het ontwerp houdt daar één gutter tussen, geen twee. */}
  <section class="p-3 pb-0 lg:bg-soft lg:p-4">
    <div
      class="rounded-card bg-page max-lg:border max-lg:border-hair lg:rounded-frame"
    >
      <div
        class="mx-auto grid max-w-site items-center gap-4 p-[22px] lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:gap-12 lg:p-14"
      >
        <div class="flex flex-col gap-[10px] lg:gap-[18px]">
          <Eyebrow>Over mij — Vera Wolff</Eyebrow>
          <h1 class="text-d40 lg:text-d62">
            Een trendy<br class="hidden lg:inline" /> nagelstyliste
          </h1>
          <p
            class="font-display text-d18 text-ink-700 italic lg:max-w-[480px] lg:text-d24 leading-normal"
          >
            "Van een simpele hobby is het uitgegroeid tot mijn passie en volwaardig
            beroep als nagelstyliste."
          </p>
          {/* Alleen op desktop, net als in het ontwerp: op mobiel gaat de ruimte
              naar het portret en staan dezelfde feiten verderop in het verhaal
              ('oktober 2023') en in de footer (Hengelo). */}
          <ul class="hidden list-none flex-wrap gap-2 pt-[6px] lg:flex">
            <li><Chip>Salon sinds oktober 2023</Chip></li>
            <li><Chip>Hengelo (OV)</Chip></li>
          </ul>
        </div>

        {/* Op mobiel boven de tekst, op desktop ernaast. De h1 blijft zo hoe dan
            ook het eerste element in de DOM. */}
        <div class="relative grid aspect-square place-items-center max-lg:order-first">
          <div
            class="absolute inset-0 rounded-full border border-line"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative aspect-square w-[92%] overflow-hidden rounded-full bg-arch shadow-soft"
          >
            {/* De foto beslaat 122% van dit kader; op mobiel is dat meer dan de
                schermbreedte, vandaar een `sizes` boven de 100vw. Met 100vw koos
                de browser een variant die op een 2×-scherm te zacht werd. */}
            <div class="absolute -inset-[11%]">
              <Photo
                photo={photos.veraPortret}
                priority
                sizes="(min-width: 1024px) 584px, 110vw"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div
    class="mx-auto flex max-w-site flex-col gap-3 px-gutter-m pt-3 pb-3 lg:gap-10 lg:px-gutter lg:pt-13 lg:pb-10"
  >
    {/* ---------- It runs in the family ---------- */}
    <section class="grid items-stretch gap-3 lg:grid-cols-2 lg:gap-4">
      {/* `flush` en dan zelf de padding: het ontwerp zet deze twee kaarten op
          40px in plaats van de 30px die Card standaard geeft. */}
      <Card flush class="flex items-center p-[22px] lg:p-10">
        <div class="flex flex-col gap-3 lg:gap-4">
          <Eyebrow>Hoe Nails by Vera ontstaan is</Eyebrow>
          <h2 class="text-d28 italic lg:text-d38">'It runs in the family'</h2>
          <p class="text-b15 text-copy lg:text-b16">
            Van een simpele hobby is het uitgegroeid tot mijn passie en volwaardig
            beroep als nagelstyliste. Het avontuur begon samen met mijn tante, een
            ervaren nagelstyliste in een drukke salon. Telkens als ik bij haar was,
            nam ze de tijd om mijn nagels prachtig te stylen. Helaas woonde ze ver
            weg, waardoor dit niet vaak kon gebeuren. Maar dat inspireerde me om
            het zelf te leren!
          </p>
          <p class="text-b15 text-copy lg:text-b16">
            In april 2022 verwelkomden mijn vriend en ik ons kleine meisje. Dat was
            het moment waarop ik besefte dat ik meer wilde genieten van elk moment
            en wilde doen waar ik echt van hou. De herinneringen aan mijn tante
            kwamen weer naar boven, en nu werk ik ook in de beauty-industrie. Hoe
            fantastisch is dat?
          </p>
          <p class="font-display text-d18 text-heading italic lg:text-d20">
            – Vera Wolff
          </p>
        </div>
      </Card>

      <PhotoFrame
        photo={photos.kersroodHerfst}
        radius="frame"
        sizes="(min-width: 1024px) 600px, 100vw"
        class="max-lg:rounded-card-m min-h-[300px] lg:min-h-[520px]"
      />
    </section>

    {/* ---------- Dream big ----------
        Op desktop staat de foto links, op mobiel onder de tekst — vandaar de
        kaart eerst in de DOM en `lg:order-first` op de foto. */}
    <section class="grid items-stretch gap-3 lg:grid-cols-2 lg:gap-4">
      <Card flush class="flex items-center p-[22px] lg:p-10">
        <div class="flex flex-col gap-3 lg:gap-4">
          <Eyebrow>Carrière</Eyebrow>
          <h2 class="text-d28 lg:text-d38">Dream big</h2>
          <p class="text-b15 text-copy lg:text-b16">
            Na het afronden van diverse opleidingen en cursussen, waaronder die van
            Magnetic Nail Design, Julia Visser en Tanya Savchenko, besloot ik mijn
            eigen salon aan huis te starten. In eerste instantie begon ik met het
            verzorgen van nagels voor vrienden en familie, waarna het uitgroeide
            tot werkzaam zijn in een nagelsalon in de buurt. En met veel
            enthousiasme opende ik toen in oktober 2023 mijn eigen salon!
          </p>
          <p class="text-b15 text-copy lg:text-b16">
            Mijn hoofd zit boordevol ideeën die steeds maar groter worden. Mijn
            ultieme droom? De salon omtoveren tot een complete beauty hotspot.
            Onlangs heb ik ook mijn gloednieuwe webshop gelanceerd, en ik heb
            plannen om deze constant uit te breiden. Wie weet welke nieuwe
            uitdagingen er nog op mijn pad zullen komen!
          </p>
          <ul class="flex list-none flex-wrap gap-2">
            {opleidingen.map((opleiding) => <li><Chip>{opleiding}</Chip></li>)}
          </ul>
        </div>
      </Card>

      <PhotoFrame
        photo={photos.blauweBloemetjesRoos}
        radius="frame"
        sizes="(min-width: 1024px) 600px, 100vw"
        class="max-lg:rounded-card-m min-h-[300px] lg:order-first lg:min-h-[460px]"
      />
    </section>

    {/* ---------- Fotoraster ----------
        Het ontwerp geeft deze sectie geen kop; zonder h2 zou hier een blok
        zonder titel staan. Dezelfde oplossing als bij de stappenband op de home. */}
    <section>
      <h2 class="sr-only">Uit de salon</h2>
      <div
        class="grid auto-rows-[150px] grid-cols-2 gap-3 lg:auto-rows-[220px] lg:grid-cols-4 lg:gap-4"
      >
        {
          salonfotos.map((photo) => (
            <PhotoFrame
              photo={photo}
              sizes="(min-width: 1024px) 300px, 50vw"
              lift
              class="max-lg:rounded-card-m"
            />
          ))
        }
      </div>
    </section>

    {/* ---------- CTA ---------- */}
    <CtaBand
      eyebrow="Plan jouw naildate"
      title="Kom langs en ontspan!"
      text="Door een breed scala aan behandelingen kan jij ongetwijfeld genieten van prachtige nagels die bij jou passen. Kom snel langs en ervaar het zelf."
      label="Maak jouw afspraak"
    />
  </div>

  <StickyBookingBar />
</Base>
