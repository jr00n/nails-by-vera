---
/**
 * Portfolio — het ontwerp "Editorial Frames" (TASK-7.5).
 *
 * Referentie: design_handoff_nailsbyvera/Portfolio.dc.html, links de
 * desktoprender op 1280px en rechts de mobiele op 390px.
 *
 * De tegels komen uit de collection `portfolio`: volgorde, tegelgrootte en de
 * categorie waarop het filter selecteert. Dat filter staat onderaan dit bestand
 * (TASK-9, PRD §5.3): zonder JavaScript is de filterrij er niet en staan alle
 * tegels er gewoon.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookingButton from '../components/BookingButton.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Header from '../components/Header.astro';
import Photo from '../components/Photo.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import StickyBookingBar from '../components/StickyBookingBar.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { photos } from '../data/images';
import { social } from '../data/site';

const tiles = (await getCollection('portfolio')).sort(
  (a, b) => a.data.order - b.data.order,
);

// De filterrij volgt uit de content en niet uit een vaste lijst (PRD §5.3):
// alleen categorieën die daadwerkelijk in het raster zitten, krijgen een chip.
// De desktoprender toont er zes, waaronder "Verlenging" en "French & babyboom",
// terwijl de mobiele render dezelfde vier laat zien die hier uitkomen.
const labels = {
  versteviging: 'Versteviging',
  gellak: 'Gellak',
  nailart: 'Nail art',
} as const;

const used = new Set(tiles.map((tile) => tile.data.category));
const filters = (Object.keys(labels) as (keyof typeof labels)[]).filter((key) =>
  used.has(key),
);

// Tegelgroottes uit het ontwerp. Op mobiel worden beide afwijkende maten de
// volle breedte; het raster heeft daar maar twee kolommen.
const spans = {
  large: 'col-span-2 row-span-2',
  wide: 'col-span-2',
};

// De twee reviewkaarten uit het ontwerp. Nog zonder de "· 7 maanden geleden" die
// het prototype erbij zet: die is relatief aan het moment waarop het ontwerp
// gemaakt werd. Zodra TASK-4 de echte datums levert, vult `date` in de collection
// zich en kan die regel terugkomen.
const reviews = (await getCollection('reviews')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Portfolio"
  description="Recent werk uit de salon in Hengelo (OV): gellak, nagelversteviging en nail art. Van minimale french tot volledig uitgewerkte designs."
  header="none"
>
  {/* ---------- Hero ---------- */}
  <section class="bg-soft p-3 lg:p-4">
    <div class="relative h-[400px] overflow-hidden rounded-card lg:h-[420px] lg:rounded-frame">
      <Photo
        photo={photos.nudeNatuurlijk}
        priority
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
      {/* Verloop uit het ontwerp; ink-900 op drie alfawaarden. */}
      <div
        class="absolute inset-0 bg-linear-to-b from-ink-900/[0.34] via-ink-900/[0.1] to-ink-900/60 via-45%"
        aria-hidden="true"
      >
      </div>
      {/* Extra scrims, niet in het ontwerp — vierde pagina op rij waar de
          hero-foto licht is op de plek waar de tekst staat. Zie de
          implementatienotities bij TASK-7.5 voor de gemeten waarden. */}
      <div
        class="absolute inset-0 bg-linear-to-t from-ink-900/70 to-transparent lg:from-ink-900/45 lg:to-70%"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-r from-ink-900/45 to-transparent to-60%"
        aria-hidden="true"
      >
      </div>

      <Header floating />

      <div class="absolute inset-x-[18px] bottom-5 max-w-[760px] lg:inset-x-10 lg:bottom-9">
        <Eyebrow onDark class="mb-[10px] lg:mb-[14px]">Portfolio</Eyebrow>
        <h1 class="text-d38 text-white lg:text-d62">Recent werk uit de salon</h1>
        <p
          class="mt-[10px] text-b15 text-white/85 lg:mt-[14px] lg:max-w-[560px] lg:text-b17"
        >
          Van minimale french tot volledig uitgewerkte nail art — een greep uit
          de sets die ik de afgelopen maanden zette.
        </p>
      </div>
    </div>
  </section>

  <div
    class="mx-auto flex max-w-site flex-col gap-3 px-gutter-m pt-3 pb-3 lg:gap-5 lg:px-gutter lg:pt-11 lg:pb-10"
  >
    {/* ---------- Het werk ----------
        Het ontwerp geeft deze sectie geen kop; zonder h2 zou hier een blok
        zonder titel staan. Zelfde oplossing als bij de stappenband op de home. */}
    <section>
      <h2 class="sr-only">Recent werk</h2>

      <div
        class="flex flex-wrap items-center justify-between gap-3 pb-3 lg:gap-6 lg:pb-5"
      >
        {/* `data-js-only`: zonder JavaScript filtert hier niets, dus verbergt
            global.css deze rij en blijven alle tegels gewoon staan (PRD §5.3).

            Alle chips delen één set klassen en de actieve staat loopt via
            `aria-pressed` — dat is precies wat de handoff tekent (13px, 8px
            verticaal; de actieve chip heeft 16px in plaats van 14px horizontaal
            omdat hij geen rand heeft). Zo hoeft het script geen klassen te
            wisselen en verspringt de rij niet bij het filteren. */}
        <div class="flex flex-wrap gap-2" data-js-only data-portfolio-filter>
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="rounded-pill border border-hair bg-blush-100 px-[14px] py-2 text-b13 text-ink-700 transition ease-brand hover:border-line aria-pressed:border-ink-900 aria-pressed:bg-ink-900 aria-pressed:text-white"
          >
            Alles
          </button>
          {
            filters.map((key) => (
              <button
                type="button"
                data-filter={key}
                aria-pressed="false"
                class="rounded-pill border border-hair bg-blush-100 px-[14px] py-2 text-b13 text-ink-700 transition ease-brand hover:border-line aria-pressed:border-ink-900 aria-pressed:bg-ink-900 aria-pressed:text-white"
              >
                {labels[key]}
              </button>
            ))
          }
        </div>

        <a
          href={social.instagram}
          target="_blank"
          rel="noopener"
          class="text-b15 text-copy transition ease-brand hover:text-accent-hover"
        >
          Meer werk zie je op Instagram — {social.instagramHandle} →
        </a>
      </div>

      <div
        data-portfolio-grid
        class="grid auto-rows-[150px] grid-cols-2 gap-3 lg:auto-rows-[230px] lg:grid-cols-4 lg:gap-4"
      >
        {
          tiles.map((tile) => (
            <PhotoFrame
              photo={photos[tile.data.photo]}
              sizes="(min-width: 1024px) 620px, 50vw"
              lift
              data-category={tile.data.category}
              class:list={[
                'max-lg:rounded-card-m',
                tile.data.span && spans[tile.data.span],
              ]}
            />
          ))
        }
      </div>
    </section>

    {/* ---------- Reviews en boeken ----------
        Eén rij van drie kaarten in het ontwerp: twee reviews en een boekkaart.
        De sectie heeft geen zichtbare kop; de boekkaart draagt zijn eigen h3. */}
    <section>
      <h2 class="sr-only">Wat klanten zeggen</h2>
      <div class="grid gap-3 lg:grid-cols-3 lg:gap-4">
        {
          reviews.map((review) => (
            <TestimonialCard
              quote={review.data.quote}
              author={review.data.author}
              rating={review.data.rating}
            />
          ))
        }

        <Card tone="arch" class="flex flex-col gap-[10px]">
          <h3 class="text-d30 lg:text-d34">Zelf zo'n set?</h3>
          <p class="text-b15 text-copy">
            Neem een foto mee als inspiratie — samen maken we er iets van dat bij
            jouw handen past.
          </p>
          <BookingButton class="mt-2 self-start" />
        </Card>
      </div>
    </section>

    {/* ---------- CTA ---------- */}
    <CtaBand
      eyebrow="Plan jouw naildate"
      title="Genieten van de perfecte nagels?"
      text="Er zijn meerdere behandelingen beschikbaar bij Nails by Vera. Zo zit er altijd wat tussen wat bij jou past!"
      label="Boek nu"
    />
  </div>

  <StickyBookingBar />
</Base>

<script>
  /**
   * Het portfoliofilter (PRD §5.3, TASK-9).
   *
   * Toont of verbergt de tegels op hun `data-category`, zonder paginalading.
   * De filterrij zelf staat er zonder JavaScript niet, dus dit script hoeft
   * alleen nog het geval "wel JavaScript" af te handelen.
   */
  const row = document.querySelector('[data-portfolio-filter]');
  const grid = document.querySelector('[data-portfolio-grid]');

  if (row instanceof HTMLElement && grid instanceof HTMLElement) {
    const chips = Array.from(
      row.querySelectorAll<HTMLButtonElement>('[data-filter]'),
    );
    const tiles = Array.from(
      grid.querySelectorAll<HTMLElement>('[data-category]'),
    );

    row.addEventListener('click', (event) => {
      const chip =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>('[data-filter]')
          : null;
      if (!chip) return;

      const active = chip.dataset.filter;
      // `aria-pressed` is hier niet alleen de aankondiging maar ook de opmaak:
      // de donkere pill hangt aan de aria-pressed-variant in de klassen.
      for (const other of chips) {
        other.setAttribute('aria-pressed', String(other === chip));
      }

      for (const tile of tiles) {
        tile.hidden = active !== 'all' && tile.dataset.category !== active;
      }
    });
  }
</script>
