---
/**
 * Basislayout — de <head>, de header, de footer en de skip-link.
 *
 * Elke pagina van de site hangt hieronder. Wat hier nog niet in zit en bewust
 * later komt: Open Graph en canonical (TASK-12), structured data (TASK-12),
 * analytics (TASK-13) en de sticky boekbalk op mobiel (TASK-9).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Paginatitel zonder merknaam; die wordt hier toegevoegd. */
  title: string;
  description?: string;
  /** Buiten de index houden — voor interne pagina's zoals de stijlgids. */
  noindex?: boolean;
  /**
   * 'none' als de pagina de navigatie zelf over haar hero plaatst met
   * `<Header floating />`. Dat is het geval op alle zes contentpagina's.
   */
  header?: 'solid' | 'none';
}

const {
  title,
  description = site.description,
  noindex = false,
  header = 'solid',
} = Astro.props;
const fullTitle = `${title} · ${site.name}`;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-pill focus:bg-ink-900 focus:px-5 focus:py-3 focus:text-b14 focus:text-white"
    >
      Naar de inhoud
    </a>

    {header === 'solid' && <Header />}

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
