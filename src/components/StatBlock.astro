---
/**
 * Een groot displaycijfer met een korte toelichting: "7 dagen — garantie op je
 * nieuwe set", "1 op 1 — privésalon".
 *
 * `layout="row"` zet het cijfer naast het label met een dunne verticale lijn
 * ertussen (de variant uit het design system); `stack` zet ze onder elkaar, zoals
 * de bento-kaarten op de home.
 *
 * `size` bestaat omdat het ontwerp twee maten voor het cijfer gebruikt: 44px op
 * de home, 38px in de statkaarten van de behandelingenpagina.
 */
type Size = 'd44' | 'd38';

interface Props {
  value: string;
  layout?: 'row' | 'stack';
  size?: Size;
  onDark?: boolean;
  class?: string;
}

const {
  value,
  layout = 'stack',
  size = 'd44',
  onDark = false,
  class: className,
} = Astro.props;
const row = layout === 'row';

// Volledige klassenamen, geen samenstelling — Tailwind scant de bron als tekst.
const sizes: Record<Size, string> = {
  d44: 'text-d44',
  d38: 'text-d38',
};
---

<div
  class:list={[
    'flex',
    row ? 'flex-row items-center gap-6' : 'flex-col items-start gap-2',
    className,
  ]}
>
  <span
    class:list={[
      sizes[size],
      'leading-none whitespace-nowrap',
      onDark ? 'text-white' : 'text-heading',
    ]}
  >
    {value}
  </span>
  <span
    class:list={[
      'flex items-center text-b15',
      row && 'max-w-40 self-stretch border-l border-line pl-6',
      onDark ? 'text-white/80' : 'text-copy',
    ]}
  >
    <slot />
  </span>
</div>
