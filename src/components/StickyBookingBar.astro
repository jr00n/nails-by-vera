---
/**
 * De boekbalk die op mobiel onderaan meescrollt (PRD §5.1).
 *
 * Alleen onder de lg-breakpoint zichtbaar; op desktop is de boek-CTA altijd in
 * beeld via de zwevende header. De balk vraagt om ruimte onder de footer, anders
 * dekt hij de laatste regels af — vandaar de spacer die met hem meeschakelt.
 */
import BookingButton from './BookingButton.astro';
import { site } from '../data/site';
---

<div class="h-20 lg:hidden" aria-hidden="true"></div>

<div
  class="fixed inset-x-3 bottom-3 z-40 flex items-center justify-between gap-3 rounded-pill bg-ink-900 py-[10px] pr-[10px] pl-5 lg:hidden"
>
  <span class="text-b14 text-white">{site.name} · Hengelo</span>
  <BookingButton variant="onDark" size="sm" />
</div>
