---
/**
 * De Salonized-boekwidget overlay (TASK-21).
 *
 * In plaats van de bezoeker weg te sturen naar salonized.com, opent elke
 * boek-CTA op de site het formulier direct als een overlay op de pagina.
 *
 * Waarom een directe iframe-overlay in plaats van static-widget.salonized.com/loader.js:
 * 1. Het externe script van Salonized injecteert altijd een zwevende button-iframe
 *    ("Maak afspraak" / TW) die we juist niet willen tonen.
 * 2. Het externe script bevat een bug op `localhost`: het checkt op "localhost"
 *    en probeert dan te verbinden met interne ontwikkelaarspoorten (8090 / 8092),
 *    wat een gecrashte grijze iframe-fout (📄☹️) oplevert in de browser.
 * 3. Onze directe handler laadt het iframe pas zodra iemand daadwerkelijk wil boeken
 *    (lazy loading), bewaart de userDetails in localStorage zoals afgesproken in de
 *    privacyverklaring, en reageert op de sluit-berichten van Salonized.
 */
import { bookingWidget } from '../data/site';

const widgetUrl = `https://widget.salonized.com/widget?company=${encodeURIComponent(
  bookingWidget.company
)}&color=${encodeURIComponent(bookingWidget.color)}&language=${encodeURIComponent(
  bookingWidget.language
)}`;
---

<div
  id="sz-widget-container"
  data-widget-url={widgetUrl}
  class="hidden"
  aria-hidden="true"
>
</div>

<script is:inline>
  (() => {
    const container = document.getElementById('sz-widget-container');
    if (!container) return;

    const widgetUrl = container.getAttribute('data-widget-url');
    let iframe = null;
    let isVisible = false;

    function createIframe() {
      if (iframe) return iframe;

      iframe = document.createElement('iframe');
      iframe.src = widgetUrl;
      iframe.setAttribute('allowtransparency', 'true');
      iframe.setAttribute('allow', 'geolocation');
      iframe.className = 'sz-custom-overlay';

      iframe.style.position = 'fixed';
      iframe.style.zIndex = '2147483647';
      iframe.style.border = '0';
      iframe.style.backgroundColor = '#ffffff';
      iframe.style.transition =
        'transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease';
      iframe.style.transform = 'translateY(20px)';
      iframe.style.opacity = '0';
      iframe.style.pointerEvents = 'none';

      document.body.appendChild(iframe);

      // Stuur eerdere gebruikersgegevens door zodra de iframe geladen is
      iframe.addEventListener('load', () => {
        try {
          const userDetails = localStorage.getItem('bookingUserDetails');
          if (userDetails && iframe.contentWindow) {
            iframe.contentWindow.postMessage({ userDetails }, '*');
          }
        } catch {
          // localStorage niet beschikbaar
        }
      });

      return iframe;
    }

    function showWidget() {
      const frame = createIframe();
      isVisible = true;
      frame.style.display = 'block';
      // Forceer layout reflow voor animatie
      void frame.offsetHeight;
      frame.style.pointerEvents = 'auto';
      frame.style.transform = 'translateY(0)';
      frame.style.opacity = '1';
    }

    function hideWidget() {
      if (!iframe || !isVisible) return;
      isVisible = false;
      iframe.style.pointerEvents = 'none';
      iframe.style.transform = 'translateY(20px)';
      iframe.style.opacity = '0';
      setTimeout(() => {
        if (!isVisible && iframe) {
          iframe.style.display = 'none';
        }
      }, 240);
    }

    function toggleWidget() {
      if (isVisible) {
        hideWidget();
      } else {
        showWidget();
      }
    }

    // Exposeer globally op window.szBooking voor compatibiliteit
    window.szBooking = {
      showWidget,
      hideWidget,
      toggleWidget,
    };

    // Luister naar berichten van het Salonized-formulier
    window.addEventListener('message', (event) => {
      const data = event.data;
      if (!data) return;

      if (data === 'booking-close' || data === 'booking-toggle') {
        hideWidget();
      } else if (data === 'szRefreshIframe' && iframe) {
        iframe.src = widgetUrl;
      } else if (data === 'szOpenSalonizedWebsite') {
        window.open('https://www.salonized.com', '_blank');
      } else if (data.userDetails) {
        try {
          localStorage.setItem('bookingUserDetails', data.userDetails);
        } catch {
          // localStorage niet beschikbaar
        }
      }
    });

    // Sluiten met Escape-toets
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isVisible) {
        hideWidget();
      }
    });

    // Koppel alle boek-CTA's aan de widget
    document.addEventListener('click', (event) => {
      const cta =
        event.target instanceof Element &&
        event.target.closest('[data-booking-cta]');
      if (!cta) return;

      if (
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        event.button !== 0
      )
        return;

      event.preventDefault();
      showWidget();
    });
  })();
</script>

<style is:global>
  /* Responsieve afmetingen voor de Salonized boekoverlay */
  @media (min-width: 48rem) {
    .sz-custom-overlay {
      right: 22px !important;
      bottom: 22px !important;
      width: 488px !important;
      height: 744px !important;
      max-width: calc(100% - 44px) !important;
      max-height: calc(100vh - 44px) !important;
      border-radius: 12px !important;
      box-shadow: 0 16px 48px -12px rgba(28, 26, 25, 0.28) !important;
    }
  }

  @media (max-width: 47.99rem) {
    .sz-custom-overlay {
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      border-radius: 0 !important;
    }
  }

  /* Blokkeer eventuele oude externe button-iframes */
  body > iframe:not(.sz-custom-overlay) {
    display: none !important;
  }
</style>
