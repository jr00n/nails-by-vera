---
/**
 * De footer: vier kolommen (logo en claim, menu, contact, openingstijden) met
 * daaronder de copyrightregel.
 *
 * De prototypes tekenen op de home een compacte footer van één regel; de
 * handoff-README beschrijft de vier kolommen. De README is gevolgd, want dit is
 * de footer van álle pagina's en één regel is te weinig om contact en
 * openingstijden kwijt te kunnen.
 *
 * Adres, telefoon en openingstijden komen uit `src/data/site.ts`. Diezelfde bron
 * voedt straks de structured data (TASK-12), zodat de NAP-gegevens op de site en
 * in het schema nooit uit elkaar kunnen lopen (PRD §8.3).
 */
import { contact, navigation, openingHours, site, social } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-hair">
  <div
    class="mx-auto grid max-w-site gap-10 px-gutter-m py-12 md:grid-cols-2 lg:grid-cols-4 lg:px-gutter"
  >
    <div>
      <Logo height={44} />
      {/* Geen eigen claim verzinnen: de copy is definitief (PRD §5.5). Dit is de
          tagline zoals hij in het ontwerp boven de hero staat. */}
      <p class="mt-3 text-b14 text-copy">{site.tagline}</p>
    </div>

    <nav aria-labelledby="footer-menu">
      <h2 id="footer-menu" class="text-b12 tracking-eyebrow text-eyebrow uppercase">
        Menu
      </h2>
      <ul class="mt-3 space-y-1 text-b14 text-copy">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class="transition ease-brand hover:text-heading">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/privacy/" class="transition ease-brand hover:text-heading">
            Privacy
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="text-b12 tracking-eyebrow text-eyebrow uppercase">Contact</h2>
      <address class="mt-3 space-y-1 text-b14 text-copy not-italic">
        <p>{contact.street}</p>
        <p>{contact.city}</p>
        <p>
          <a
            href={`tel:${contact.phoneHref}`}
            class="transition ease-brand hover:text-heading"
          >
            {contact.phoneDisplay}
          </a>
        </p>
        <p>
          <a
            href={`mailto:${contact.email}`}
            class="transition ease-brand hover:text-heading"
          >
            {contact.email}
          </a>
        </p>
        <p>
          <a
            href={social.instagram}
            target="_blank"
            rel="noopener"
            class="transition ease-brand hover:text-heading"
          >
            {social.instagramHandle}
          </a>
        </p>
      </address>
    </div>

    <div>
      <h2 class="text-b12 tracking-eyebrow text-eyebrow uppercase">
        Openingstijden
      </h2>
      <dl class="mt-3 space-y-1 text-b14 text-copy">
        {
          openingHours.map((slot) => (
            <div class="flex justify-between gap-4">
              <dt>{slot.label}</dt>
              <dd>
                {slot.from}–{slot.to}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="border-t border-hair">
    <div
      class="mx-auto max-w-site px-gutter-m py-6 text-b13 text-copy lg:px-gutter"
    >
      © {year} {site.name}
    </div>
  </div>
</footer>
