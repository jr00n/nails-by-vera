---
/**
 * Basisfooter — contactgegevens, openingstijden en menu.
 *
 * Net als de header bewust sober; de vier-koloms opmaak uit het ontwerp komt
 * bij TASK-7.1. De gegevens komen uit src/data/site.ts, zodat adres, telefoon
 * en openingstijden nooit uit elkaar kunnen lopen met de structured data
 * (PRD §5.4, §8.3).
 */
import { contact, navigation, openingHours, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-hair">
  <div
    class="mx-auto grid max-w-site gap-10 px-gutter-m py-12 md:grid-cols-3 lg:px-gutter"
  >
    <div>
      <p class="font-display text-d26 text-heading">{site.name}</p>
      <p class="mt-2 text-b14 text-copy">{site.tagline}</p>
    </div>

    <div>
      <h2 class="text-b12 tracking-eyebrow text-eyebrow uppercase">Contact</h2>
      <address class="mt-3 space-y-1 text-b14 text-copy not-italic">
        <p>{contact.street}</p>
        <p>{contact.city}</p>
        <p>
          <a href={`tel:${contact.phoneHref}`} class="hover:text-heading"
            >{contact.phoneDisplay}</a
          >
        </p>
        <p>
          <a href={`mailto:${contact.email}`} class="hover:text-heading"
            >{contact.email}</a
          >
        </p>
      </address>
    </div>

    <div>
      <h2 class="text-b12 tracking-eyebrow text-eyebrow uppercase">
        Openingstijden
      </h2>
      <dl class="mt-3 space-y-1 text-b14 text-copy">
        {
          openingHours.map((slot) => (
            <div class="flex justify-between gap-4">
              <dt>{slot.label}</dt>
              <dd>{slot.from}–{slot.to}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="border-t border-hair">
    <div
      class="mx-auto flex max-w-site flex-wrap items-center justify-between gap-4 px-gutter-m py-6 text-b13 lg:px-gutter"
    >
      <nav aria-label="Footernavigatie">
        <ul class="flex flex-wrap gap-4 text-copy">
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} class="hover:text-heading">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {/* text-muted (ink-400) haalt AA niet voor bodytekst; hier bewust alleen
          voor decoratieve meta gebruikt (PRD §6.3). */}
      <p class="text-muted">© {year} {site.name}</p>
    </div>
  </div>
</footer>
