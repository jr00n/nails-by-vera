---
/**
 * Een prijskaart: een kop met daaronder regels van label links en prijs rechts,
 * gescheiden door hairlines.
 *
 * De regels komen als `rows`-prop binnen en niet als slot-inhoud, omdat de
 * prijzen uit een content collection moeten komen (PRD §5.5): een prijswijziging
 * hoort één regel in één databestand te zijn, zonder de opmaak aan te raken.
 *
 * `<dl>` in plaats van divs: het zijn letterlijk termen met bijbehorende waarden.
 * Dat leest een schermlezer als een lijst voor, en het maakt de koppeling tussen
 * behandeling en prijs expliciet voor systemen die de pagina uitlezen (PRD §8.4).
 */
import Card from './Card.astro';

export interface PriceRow {
  label: string;
  price: string;
  /** Optionele toelichting onder het label, bijvoorbeeld "incl. nabehandeling". */
  note?: string;
}

interface Props {
  title: string;
  rows: readonly PriceRow[];
  /** Voetnoot onder de kaart, bijvoorbeeld hoe nail art geprijsd wordt. */
  note?: string;
  /** Kopniveau, zodat de pagina een kloppende kopstructuur houdt. */
  level?: 2 | 3 | 4;
  class?: string;
}

const { title, rows, note, level = 3, class: className } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
---

<Card class={className}>
  <Heading class="mb-[10px] text-d30">{title}</Heading>

  <dl>
    {
      rows.map((row) => (
        <div class="flex items-baseline justify-between gap-4 border-t border-hair py-[14px]">
          <dt class="text-b16 text-ink-700">
            {row.label}
            {row.note && <span class="block text-b13 text-copy">{row.note}</span>}
          </dt>
          <dd class="font-display text-d22 whitespace-nowrap text-heading">
            {row.price}
          </dd>
        </div>
      ))
    }
  </dl>

  {/* Het ontwerp zet deze regel in ink-400 (3,06:1). Een toelichting bij een
      prijs is een feit dat bezoekers lezen, geen decoratie — dus ink-600,
      dezelfde correctie als bij de meta-regel van ServiceCard (TASK-6). */}
  {note && <p class="pt-3 text-b13 text-copy">{note}</p>}
</Card>
